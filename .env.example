# Hugging Face — dataset access (Egocentric-10K/100K are contact-gated; 1M returns 404, no
# such dataset exists — see docs/UPSTREAM-FINDINGS.md F6)
HF_TOKEN=

# Judge panel. GEMINI is the replication target: Build AI's published metric uses
# gemini-2.5-flash. ANTHROPIC is the second frontier judge. The open judge (Qwen3-VL)
# runs locally or on Modal and needs no key -- that is the point of including it.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Modal — the only paid compute path (L4 24GB for the distilled judge)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Set to a non-empty string to run label collection unattended. Off by default:
# human labelling is the one step that must not be automated.
VERNIER_APPROVE_ALL=
